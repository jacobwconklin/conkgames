---
import Layout from '../layouts/Layout.astro';
import { labs } from '../data/labs';
const featured = labs.find(lab => lab.featured) ?? labs[0];
---

<Layout title="ConkGames Labs — Create, Explore, Experiment">
  <canvas id="dna-background" aria-hidden="true"></canvas>
  <header>
    <a class="logo pixel" href="/" aria-label="Conk Games home"><span>CONK</span><span>GAMES</span></a>
    <h1 class="pixel">STEM LABS</h1>
  </header>
  <main>
    <a class="hero glass" href={featured.url}>
      <div class="hero-copy">
        <span class="eyebrow pixel">CURRENT LAB · 01</span>
        <h2 class="pixel">{featured.title}</h2>
        <p>{featured.description}</p>
        <span class="cta pixel">Explore lab <span aria-hidden="true">→</span></span>
      </div>
      <img src={featured.thumbnail} alt="" width="640" height="400" />
    </a>
    <section aria-labelledby="all-labs">
      <h2 id="all-labs" class="section-title pixel">ALL LABS</h2>
      <div class="grid">
        {labs.map(lab => (
          <a class="game-card glass" href={lab.url}>
            <div class="thumb-wrap"><img src={lab.thumbnail} alt="" width="640" height="400" /></div>
            <div class="card-body">
              <h3 class="pixel">{lab.title}</h3>
              <p>{lab.description}</p>
              <div class="card-meta">
                <span>👤 <span class="pixel">{lab.players}</span></span>
                <span>💻 <span class="pixel">{lab.platforms.join(' + ')}</span></span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <footer><a href="/">← Back to Conk Games</a></footer>
</Layout>

<style>
  #dna-background { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; background: radial-gradient(ellipse at 50% 30%, #252039 0%, #100c20 65%, #0a0010 100%); }
  header, main, footer { position: relative; z-index: 1; }
  header { padding: 4rem 1rem 2.5rem; text-align: center; }
  .logo { font-size: clamp(1.6rem, 6vw, 4rem); text-decoration: none; line-height: 1.3; }
  .logo span:first-child { color: var(--neon-cyan); text-shadow: 0 0 12px var(--neon-cyan), 0 0 30px #00f5ff66; }
  .logo span:last-child { color: var(--neon-pink); text-shadow: 0 0 12px var(--neon-pink), 0 0 30px #ff2d7866; }
  h1 { margin: 1.4rem 0 1rem; font-size: 1rem; letter-spacing: .4em; color: #c8baff; }
  header p { font-size: .95rem; color: #d0c7de; line-height: 1.6; }
  main { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .glass { background: linear-gradient(135deg, #ffffff1a, #ffffff0a); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); border: 1px solid #ffffff2e; border-radius: 1.5rem; box-shadow: 0 8px 32px #00000073, inset 0 1px 0 #ffffff40; color: inherit; text-decoration: none; overflow: hidden; transition: transform .2s, box-shadow .2s; }
  .glass:hover { transform: translateY(-4px); box-shadow: 0 16px 48px #00000080, 0 0 24px #b9a4ff26; }
  a:focus-visible { outline: 3px solid #a7f0dd; outline-offset: 6px; }
  .hero { display: flex; align-items: center; margin-bottom: 3rem; min-height: 290px; }
  .hero-copy { flex: 1; padding: 2.5rem; }
  .eyebrow { color: #b8e8dd; font-size: .55rem; line-height: 1.8; }
  .hero h2 { font-size: clamp(1rem, 2.7vw, 1.6rem); line-height: 1.6; margin: 1rem 0; }
  .hero p { color: #ded5eb; font-size: .95rem; line-height: 1.7; max-width: 420px; }
  .cta { display: inline-block; margin-top: 1.5rem; color: #b4f0de; font-size: .6rem; line-height: 1.8; }
  .hero img { width: 36%; height: auto; margin-right: 2.5rem; border-radius: 1rem; }
  .section-title { font-size: .7rem; letter-spacing: .12em; margin-bottom: 1.5rem; color: #d2c6e8; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem; }
  .game-card { display: flex; flex-direction: column; }
  .thumb-wrap { height: 160px; background: #ffffff0d; }
  .thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .card-body { padding: 1rem 1.2rem 1.2rem; display: flex; flex-direction: column; gap: .65rem; }
  .card-body h3 { font-size: .55rem; letter-spacing: .05em; line-height: 1.8; }
  .card-body p { font-size: .82rem; line-height: 1.5; color: #d0c4df; }
  .card-meta { display: flex; flex-direction: column; gap: .3rem; font-size: .8rem; }
  .card-meta .pixel { font-size: .45rem; color: #c1b5d1; }
  footer { text-align: center; padding: 3rem 1.5rem; }
  footer a { color: #c9bddc; font-size: .85rem; text-underline-offset: 5px; }
  @media (max-width: 640px) { header { padding-top: 3rem; } .hero { flex-direction: column-reverse; } .hero-copy { padding: 1.5rem; } .hero img { width: 100%; max-height: 220px; object-fit: cover; margin: 0; border-radius: 0; } }
  @media (prefers-reduced-motion: reduce) { .glass { transition: none; } .glass:hover { transform: none; } }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#dna-background')!;
  const ctx = canvas.getContext('2d');
  if (ctx) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0, height = 0, frame = 0, phase = 0, previous = 0;
    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      const amplitude = Math.min(width * .32, 360);
      const pitch = 460;
      const x = (y: number, strand: number) => width / 2 + Math.sin(y / pitch * Math.PI * 2 + phase + strand * Math.PI) * amplitude;
      const gradient = ctx.createLinearGradient(width / 2 - amplitude, 0, width / 2 + amplitude, height);
      gradient.addColorStop(0, '#a8efda');
      gradient.addColorStop(.5, '#bbb0ef');
      gradient.addColorStop(1, '#efb9cf');
      ctx.strokeStyle = gradient;
      ctx.lineCap = 'round';
      // Rungs rise with the spiral, keeping the ladder attached to both strands.
      const offset = phase * pitch / (Math.PI * 2) % 28;
      ctx.lineWidth = 3;
      ctx.globalAlpha = .16;
      for (let y = -28 - offset; y < height + 28; y += 28) {
        ctx.beginPath(); ctx.moveTo(x(y, 0), y); ctx.lineTo(x(y, 1), y); ctx.stroke();
      }
      for (const strand of [0, 1]) {
        ctx.beginPath();
        for (let y = -8; y <= height + 8; y += 4) {
          if (y === -8) ctx.moveTo(x(y, strand), y); else ctx.lineTo(x(y, strand), y);
        }
        ctx.globalAlpha = .07; ctx.lineWidth = 32; ctx.stroke();
        ctx.globalAlpha = .12; ctx.lineWidth = 16; ctx.stroke();
        ctx.globalAlpha = .4; ctx.lineWidth = 5; ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth; height = window.innerHeight;
      canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0); draw();
    }
    function animate(time: number) {
      if (previous) phase += Math.min(time - previous, 100) * .00012;
      previous = time; draw(); frame = requestAnimationFrame(animate);
    }
    function syncMotion() {
      cancelAnimationFrame(frame); previous = 0;
      if (!motion.matches && !document.hidden) frame = requestAnimationFrame(animate);
      else draw();
    }
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', syncMotion);
    motion.addEventListener('change', syncMotion);
    resize(); syncMotion();
  }
</script>
